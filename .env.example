# EGX Decision Engine — environment configuration
# Copy this file to .env and fill in values. Every variable is optional;
# defaults shown below are what the app uses when a variable is unset.

# --- Server ---------------------------------------------------------------
# Bind address and port for the local web server.
HOST=127.0.0.1
PORT=8642

# --- Storage --------------------------------------------------------------
# SQLite database file. The parent directory is created automatically.
# Default: <project>/data/egx.db
#DB_PATH=D:/MyApps/egx-decision-engine/data/egx.db

# --- LLM briefs (optional) ------------------------------------------------
# Anthropic API key for morning briefs and stock theses. Leave unset to
# disable brief generation (the rest of the app works without it).
#ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram alerts (optional) -------------------------------------------
# Bot token from @BotFather and the chat id to deliver fired alerts to.
# Leave unset to keep alerts in-app only.
#TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
#TELEGRAM_CHAT_ID=123456789

# --- Scheduler ------------------------------------------------------------
# Set to 0 to disable the background jobs (intraday alert checks, post-close
# snapshot, morning brief, weekly maintenance).
SCHEDULER_ENABLED=1

# --- Position sizing defaults ---------------------------------------------
# Account size in EGP and default risk per trade (percent) used by the
# position-size calculator.
ACCOUNT_SIZE=100000
RISK_PCT=1.0

# --- EGX market realism ------------------------------------------------------
# All-in transaction cost per side (percent): brokerage + stamp duty +
# FRA/EGX/MCDR fees + risk insurance. Applied to both legs of every position;
# all portfolio PnL / win-rate / R figures are net of this.
FEE_PCT_PER_SIDE=0.25
# Annual EGP risk-free rate (percent) used for backtest Sharpe ratios —
# set to the current EGP T-bill yield.
RISK_FREE_RATE_PCT=25.0
# Daily price-limit band (percent) assumed when sanity-checking trade-plan
# stops/targets (EGX main market ±20%; some boards are tighter).
PRICE_BAND_PCT=20
# Candidates whose 20-day median traded value (EGP) is known to be below this
# floor are filtered out as illiquid; positions above ~15% of it get warnings.
MIN_DAILY_VALUE_EGP=5000000

# --- News (optional, read by tradingview_mcp core) ------------------------
# Marketaux token for the news/sentiment tab; degrades gracefully if unset.
#MARKETAUX_API_TOKEN=...

# --- Position Guardian (exit verdicts for open positions) ---
# Chandelier trailing stop = highest close since entry - GUARDIAN_ATR_MULT x ATR14.
GUARDIAN_ATR_MULT=2.5
# Composite-score drop (points) since entry that counts as "thesis broken".
GUARDIAN_SCORE_DROP=15

# --- Plan-quality gate (opening / editing a position) ---
# Target 1 must pay at least this many times the initial risk (entry - stop)...
MIN_RR_T1=1.5
# ...and sit at least this many ATR14 above entry (a target inside one day's
# normal range is noise, not a profit level). Both are hard blocks in the
# New-position form unless you tick the explicit override.
MIN_TARGET_ATR=1.0
# Sessions held inside +/-0.5R before the time-stop advice fires.
GUARDIAN_TIME_STOP_BARS=15
